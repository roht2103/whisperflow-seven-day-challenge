# ============================================================================
# Vercel Deployment Configuration
# ============================================================================
# Optional: Persistent Cloud SQLite (Turso) for production deployments on Vercel.
# Without these, the application runs on local SQLite (locally) or ephemeral /tmp (on Vercel).
# Create a free database at https://turso.tech (100% SQLite compatible)

TURSO_DATABASE_URL=libsql://growth-funnel-yourname.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token-here

